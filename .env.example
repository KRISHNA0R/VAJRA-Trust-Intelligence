# VAJRA Trust Intelligence - environment template.
# Copy to ".env" and set real values. NEVER commit ".env" with secrets.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env

# JWT signing key. REQUIRED for anything beyond local smoke testing.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Path to TruFor image-model weights (default is fine for native runs).
MODEL_PATH=models/trufor.pth.tar

# Server bind address/port for native runs.
HOST=127.0.0.1
PORT=8000

# Force UTF-8 console output on Windows (prevents UnicodeEncodeError in logs).
PYTHONIOENCODING=utf-8
